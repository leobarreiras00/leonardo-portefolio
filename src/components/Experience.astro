---
import { experience, education } from "../data/site";
---

<section id="experience" class="section border-t border-line">
  <div class="container-x grid gap-12 lg:grid-cols-[1fr_2fr]">
    <div class="reveal lg:sticky lg:top-28 lg:self-start">
      <p class="eyebrow">Experience</p>
      <h2 class="h2 mt-3">Where I've been building</h2>
      <p class="mt-4 max-w-xs text-sm text-muted">An internship shipping a full product, a brand of my own, and the soft skills from working with the public.</p>
    </div>

    <div>
      <ol class="relative space-y-4">
        {experience.map((e) => (
          <li class="reveal rounded-2xl border border-line bg-surface p-6 sm:p-7">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
              <h3 class="font-heading text-lg font-semibold text-ink">
                {e.role} <span class="font-normal text-accent">· {e.org}</span>
              </h3>
              <p class="font-mono text-xs text-faint">{e.period}</p>
            </div>
            <ul class="mt-4 space-y-2 text-sm leading-relaxed text-muted">
              {e.points.map((p) => (
                <li class="flex gap-2.5"><span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent"></span><span>{p}</span></li>
              ))}
            </ul>
          </li>
        ))}
      </ol>

      <div class="reveal mt-10">
        <p class="eyebrow">Education</p>
        <div class="mt-4 rounded-2xl border border-line bg-surface p-6 sm:p-7">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-heading text-lg font-semibold text-ink">{education.degree}</h3>
            <p class="font-mono text-xs text-faint">{education.period}</p>
          </div>
          <p class="mt-1 text-sm text-accent">{education.school}</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">{education.courses}</p>
        </div>
      </div>
    </div>
  </div>
</section>
