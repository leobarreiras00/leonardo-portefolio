---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { projects } from "../data/site";
import seatly from "../assets/seatly.png";
import flipora from "../assets/flipora.png";
import lbwatches from "../assets/lbwatches.png";
import caresync from "../assets/caresync.png";

const images = { seatly, flipora, lbwatches, caresync };
const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
---

<section id="work" class="section border-t border-line">
  <div class="container-x">
    <div class="reveal flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 class="h2 mt-3">Products I've designed, built and shipped</h2>
      </div>
      <p class="max-w-sm text-sm text-muted">From requirements to production, each one live or in daily use, built with real users in mind.</p>
    </div>

    <!-- Featured projects: full-width image, details in two columns -->
    {featured.map((p, i) => (
      <article id={p.slug} class={`reveal scroll-mt-24 overflow-hidden rounded-3xl border border-line bg-surface ${i === 0 ? "mt-12" : "mt-6"}`}>
        <div class="border-b border-line bg-surface-2 p-4 sm:p-6">
          <Image src={images[p.slug]} alt={p.imageAlt} width={1600} widths={[720, 1200, 1600]} sizes="(min-width: 1152px) 1040px, 95vw" class="w-full rounded-xl border border-line shadow-2xl shadow-black/40" />
        </div>
        <div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-[1fr_1.25fr] lg:gap-12">
          <div class="flex flex-col">
            <p class="font-mono text-xs text-faint">{p.kicker}</p>
            <h3 class="mt-2 font-heading text-3xl font-semibold text-ink">{p.title}</h3>
            <p class="mt-3 text-muted leading-relaxed">{p.summary}</p>
            <div class="mt-6 flex flex-wrap gap-1.5">
              {p.stack.map((t) => <span class="chip">{t}</span>)}
            </div>
            {(p.links.length > 0 || p.note) && (
              <div class="mt-6 flex flex-col items-start gap-3">
                {p.links.map((l) => (
                  <a href={l.url} target="_blank" rel="noopener" class="link-arrow">{l.label} <Icon name="mdi:arrow-top-right" class="h-4 w-4" /></a>
                ))}
                {p.note && (
                  <p class="flex items-start gap-1.5 text-xs text-faint"><Icon name="mdi:lock-outline" class="mt-px h-3.5 w-3.5 shrink-0" />{p.note}</p>
                )}
              </div>
            )}
          </div>
          <ul class="space-y-2.5 text-sm text-ink/90 lg:pt-7">
            {p.highlights.map((h) => (
              <li class="flex gap-2.5"><Icon name="mdi:check-circle" class="mt-0.5 h-4 w-4 shrink-0 text-accent" /><span>{h}</span></li>
            ))}
          </ul>
        </div>
      </article>
    ))}

    <!-- Other projects -->
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {rest.map((p) => (
        <article id={p.slug} class="reveal group flex scroll-mt-24 flex-col overflow-hidden rounded-3xl border border-line bg-surface transition-colors hover:border-accent/40">
          <div class="overflow-hidden border-b border-line bg-surface-2">
            <Image src={images[p.slug]} alt={p.imageAlt} width={900} widths={[560, 900]} sizes="(min-width: 768px) 540px, 95vw" class="aspect-[16/9] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]" />
          </div>
          <div class="flex flex-1 flex-col p-6">
            <p class="font-mono text-xs text-faint">{p.kicker}</p>
            <h3 class="mt-2 font-heading text-2xl font-semibold text-ink">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{p.summary}</p>
            <ul class="mt-4 space-y-2 text-sm text-ink/85">
              {p.highlights.map((h) => (
                <li class="flex gap-2.5"><span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent"></span><span>{h}</span></li>
              ))}
            </ul>
            <div class="mt-5 flex flex-wrap gap-1.5">
              {p.stack.map((t) => <span class="chip">{t}</span>)}
            </div>
            <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-3 pt-6">
              {p.links.map((l) => (
                <a href={l.url} target="_blank" rel="noopener" class="link-arrow">{l.label} <Icon name="mdi:arrow-top-right" class="h-4 w-4" /></a>
              ))}
              {p.note && (
                <p class="flex items-start gap-1.5 text-xs text-faint"><Icon name="mdi:lock-outline" class="mt-px h-3.5 w-3.5 shrink-0" />{p.note}</p>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
