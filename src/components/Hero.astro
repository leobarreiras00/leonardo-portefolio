---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import photo from "../assets/profile.jpg";
import { profile, stats } from "../data/site";
---

<section id="top" class="relative overflow-hidden pt-32 pb-16 md:pt-40 md:pb-24">
  <!-- background: soft glow + faint grid -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -top-40 right-[-10%] h-[520px] w-[520px] rounded-full bg-accent/25 blur-[140px]"></div>
    <div class="absolute top-60 left-[-15%] h-[380px] w-[380px] rounded-full bg-ok/10 blur-[140px]"></div>
    <div class="absolute inset-0 opacity-[0.35] [background-image:linear-gradient(var(--color-line)_1px,transparent_1px),linear-gradient(90deg,var(--color-line)_1px,transparent_1px)] [background-size:56px_56px] [mask-image:radial-gradient(ellipse_at_top,black_20%,transparent_70%)]"></div>
  </div>

  <div class="container-x relative grid items-center gap-12 lg:grid-cols-[1.35fr_1fr]">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/70 px-3 py-1.5 text-xs font-medium text-muted">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-ok opacity-60 motion-reduce:hidden"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-ok"></span>
        </span>
        {profile.availability}
      </p>

      <h1 class="mt-6 font-heading text-5xl font-semibold leading-[1.02] tracking-tight text-ink sm:text-6xl lg:text-7xl">
        {profile.name}
      </h1>
      <p class="mt-4 font-heading text-xl text-ink/90 sm:text-2xl">
        {profile.role}<br /><span class="text-accent">{profile.focus}</span>
      </p>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-muted sm:text-lg">{profile.intro}</p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#work" class="btn-primary">See my work <Icon name="mdi:arrow-down" class="h-4 w-4" /></a>
        <a href={profile.resumeUrl} target="_blank" rel="noopener" class="btn-ghost">
          <Icon name="mdi:download" class="h-4 w-4" /> Download CV
        </a>
        <div class="ml-1 flex items-center gap-1">
          {profile.socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={s.name} class="grid h-10 w-10 place-items-center rounded-full text-muted transition-colors hover:bg-surface-2 hover:text-ink">
              <Icon name={s.name === "GitHub" ? "mdi:github" : "mdi:linkedin"} class="h-5 w-5" />
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-[300px] sm:max-w-sm lg:max-w-none">
      <div class="relative overflow-hidden rounded-3xl border border-line bg-surface">
        <Image src={photo} alt={`Portrait of ${profile.name}`} width={720} widths={[400, 720]} sizes="(min-width: 1024px) 420px, 90vw" class="aspect-[4/5] w-full object-cover object-top" loading="eager" />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-bg via-bg/70 to-transparent p-5 pt-16">
          <dl class="grid grid-cols-2 gap-3 text-sm">
            <div><dt class="text-faint text-xs">Based in</dt><dd class="text-ink">{profile.location}</dd></div>
            <div><dt class="text-faint text-xs">Currently</dt><dd class="text-ink">Intern @ 4ITFUTURE</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <div class="container-x relative mt-16 md:mt-20">
    <dl class="grid grid-cols-2 overflow-hidden rounded-2xl border border-line bg-line gap-px md:grid-cols-4">
      {stats.map((s) => (
        <div class="bg-surface px-5 py-6">
          <dt class="sr-only">{s.label}</dt>
          <dd class="font-heading text-3xl font-semibold text-ink md:text-4xl">{s.value}</dd>
          <p class="mt-1 text-xs leading-snug text-muted md:text-sm">{s.label}</p>
        </div>
      ))}
    </dl>
  </div>
</section>
