---
// Vellum showcase: a looping tour of the live app, built from real captures in /public/vellum/.
// The first scene is not a screenshot: it redraws Vellum's own sign-in entrance (the pen that writes
// the signature before the modal appears) from the same SVG paths and timings as the app, driven by
// the tour clock so it can pause, resume and replay. The scene list is both navigation and progress.
// Autoplay only runs while the window is on screen, pauses on hover, can always be paused, and
// starts paused (showing the finished entrance) when the visitor prefers reduced motion.
import { Icon } from "astro-icon/components";

type Shot = { kind: "shot"; src: string; alt: string; dur: number; url: string };
type Intro = { kind: "intro"; alt: string; dur: number; url: string };
type Scene = { title: string; caption: string; steps: (Shot | Intro)[] };

const B = "/vellum/";
const shot = (file: string, alt: string, dur: number, url: string): Shot => ({ kind: "shot", src: B + file, alt, dur, url });
const PROJECT = "/projects/prj_ZIRavltRc-Q";
const DOC = PROJECT + "/documents/doc_vWF9nubRr64";

const scenes: Scene[] = [
  {
    title: "The entrance",
    caption: "Before the sign-in modal, a pen writes the signature stroke by stroke. It is drawn live from SVG paths, with a nib that tilts along the curves, and it can be skipped.",
    steps: [{ kind: "intro", alt: "Vellum entrance: a fountain pen writes the Vellum signature, then the sign-in modal rises", dur: 6200, url: "/login" }],
  },
  {
    title: "Workspace",
    caption: "Notebooks, pages and quick notes, a ⌘K palette, and a dashboard that measures real effort: active time, an effort index and editorial cadence.",
    steps: [
      shot("dash-top.webp", "Vellum dashboard greeting with the focus-session timer", 2600, "/dashboard"),
      shot("dash-stats.webp", "Dashboard statistics: real usage time, effort index, notes and pages, editorial cadence", 3000, "/dashboard"),
      shot("project.webp", "Project page with its document tree and totals", 2600, PROJECT),
      shot("palette.webp", "Command palette with actions and navigation", 2800, PROJECT),
    ],
  },
  {
    title: "A4 editor",
    caption: "A block editor on a true A4 sheet, with ruler, cover, tables, quotes and page breaks. Type, and the page count follows.",
    steps: [
      shot("editor-top.webp", "Editor with the toolbar, ruler and an A4 sheet under a geometric cover", 2800, DOC),
      shot("editor-body.webp", "Document with a heading, list, quote and a typographic scale table", 3200, DOC),
    ],
  },
  {
    title: "Mermaid studio",
    caption: "Diagrams live inside the document: edit the code, watch the figure render, caption it, and it travels with the page when you export.",
    steps: [
      shot("mermaid-split.webp", "Mermaid block in split view, code on the left and the live diagram on the right", 3000, DOC),
      shot("mermaid-diagram.webp", "The review-flow diagram with its figure caption", 3400, DOC),
    ],
  },
  {
    title: "Calendar",
    caption: "A calendar of its own, with events, important days and an agenda that pairs every date with its note.",
    steps: [
      shot("calendar.webp", "Month calendar with events and the next important day", 2900, "/calendar"),
      shot("agenda.webp", "Agenda view with a mini calendar and a note for each day", 2900, "/calendar"),
    ],
  },
  {
    title: "Export",
    caption: "PDF, Word, Markdown or standalone HTML, with a paginated preview of exactly what comes out. No reformatting afterwards.",
    steps: [shot("export.webp", "Export dialog listing PDF, Word, Markdown and HTML with a paginated A4 preview", 3800, DOC)],
  },
  {
    title: "Five themes",
    caption: "Cream, sage, slate, sand and espresso, each with a geometric wallpaper of its own. Contrast is checked against WCAG AA on all five.",
    steps: [
      shot("theme-creme.webp", "Dashboard in the Creme Quente theme", 1500, "/dashboard"),
      shot("theme-sage.webp", "Dashboard in the Papel Sálvia theme", 1500, "/dashboard"),
      shot("theme-nordic.webp", "Dashboard in the Ardósia Nórdica theme", 1500, "/dashboard"),
      shot("theme-duna.webp", "Dashboard in the Duna de Areia theme", 1500, "/dashboard"),
      shot("theme-espresso.webp", "Dashboard in the Espresso Escuro theme", 1500, "/dashboard"),
    ],
  },
];

const flat = scenes.flatMap((s, si) => s.steps.map((st) => ({ ...st, scene: si })));
const steps = flat.map((s) => ({ scene: s.scene, dur: s.dur, url: s.url, kind: s.kind }));

const facts = [
  { v: "5", k: "themes" },
  { v: "5", k: "access roles" },
  { v: "4", k: "export formats" },
];

// Signature geometry, copied from the app's entrance (viewBox units, baseline y = 112).
const STROKES = [
  "M -42 50 Q -44 48 -40 48 H -18 L -3 62.5 V 99 Q -3 102 -6 102 H -40 Q -43 102 -43 99 Z",
  "M -18 48.5 V 60 Q -18 62.5 -15.5 62.5 H -3.5",
  "M -33.5 74 L -26 90.5 L -15.5 67.5",
  "M 49.6 46 C 59.7 34 76.1 32 82 44 C 87.5 58 90.6 86 96.4 110 C 97.6 114 101.6 114 104.7 108 C 119.3 82 138.6 52 159.4 36 C 166.3 31 172.1 32 169 38",
  "M 144.8 96 C 154.5 98 171.5 92 174.9 84 C 178.3 76 166.7 74 159.3 82 C 149.2 94 148 112 164 112 C 176 112 187.8 102 197.9 90 C 213.4 70 229.6 46 227.4 36 C 224.8 28 211.7 34 206.9 50 C 198.7 74 193.4 104 204 112 C 211.3 116 221.4 104 231.9 90 C 247.4 70 263.6 46 261.4 36 C 258.8 28 245.7 34 240.9 50 C 232.7 74 227.4 104 238 112 C 245.3 116 255.4 104 263.5 92 C 268.6 86 270.9 84 272.9 84 C 268.8 96 262.7 108 272 112 C 281.6 114 292.5 98 298.9 84 C 294.5 98 290.4 110 300 112 C 306 112 311.4 104 316.8 96 C 321.9 90 326.9 84 330.9 84 C 331.5 92 325.4 104 322 112 C 328.5 98 338.9 84 348.9 84 C 356.9 84 352.1 100 348 112 C 354.5 98 364.9 84 374.9 84 C 384.9 84 380.1 100 376.7 108 C 375.6 114 383.6 114 393.1 106",
];
---

<div class="vl-showcase relative isolate overflow-hidden px-4 py-8 sm:px-8 sm:py-10 lg:px-12 lg:py-12" data-vl data-steps={JSON.stringify(steps)} data-state="paused">
  <div aria-hidden="true" class="vl-glow pointer-events-none absolute -z-10"></div>

  <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.5fr)] lg:gap-12">
    <!-- Scenes: navigation + progress -->
    <div class="order-2 min-w-0 lg:order-1">
      <ol class="flex max-w-md flex-col gap-1">
        {scenes.map((s, i) => (
          <li>
            <button type="button" class="vl-scene w-full text-left" data-vl-scene={i} aria-current={i === 0 ? "true" : "false"}>
              <span class="vl-serif block text-[1.35rem] leading-tight sm:text-2xl">{s.title}</span>
              <span class="vl-cap"><span class="vl-cap-in"><span class="mt-1.5 block text-sm leading-relaxed text-muted">{s.caption}</span></span></span>
              <span class="vl-track mt-2.5 block" aria-hidden="true"><i></i></span>
            </button>
          </li>
        ))}
      </ol>

      <dl class="mt-7 flex max-w-md gap-8 border-t border-white/10 pt-6 sm:gap-12">
        {facts.map((f) => (
          <div class="flex flex-col-reverse">
            <dt class="mt-1.5 text-xs text-faint">{f.k}</dt>
            <dd class="vl-serif vl-accent text-3xl leading-none sm:text-4xl">{f.v}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Browser window -->
    <div class="order-1 min-w-0 lg:order-2">
      <div class="vl-window" data-vl-window>
        <div class="vl-chrome">
          <span class="vl-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="vl-url" aria-hidden="true">
            <Icon name="mdi:lock-outline" class="h-3 w-3 shrink-0 opacity-70" />
            <span class="truncate"><span>vellumpt.up.railway.app</span><span data-vl-url>/login</span></span>
          </span>
          <span class="vl-chrome-gap" aria-hidden="true"></span>
        </div>

        <div class="vl-stage">
          {flat.map((s, i) =>
            s.kind === "intro" ? (
              <div class={`vl-layer vl-intro${i === 0 ? " is-on" : ""}`} data-vl-layer data-vl-intro role="img" aria-label={s.alt} aria-hidden={i === 0 ? "false" : "true"}>
                <img src="/vellum/wallpaper-sequoia.svg" alt="" width="1600" height="1000" decoding="async" draggable="false" class="vl-wall" />
                <span class="vl-veil" aria-hidden="true"></span>
                <span class="vl-skip" data-vl-skip aria-hidden="true">Saltar introdução <kbd>↵</kbd></span>

                <div class="vl-sig" aria-hidden="true">
                  <svg viewBox="-52 22 468 98" overflow="visible" class="block h-auto w-full">
                    <g fill="none" stroke="#1c1b18" stroke-linecap="round" stroke-linejoin="round">
                      <g stroke-width="1.7" transform="translate(1.05 -1.05)" opacity="0.92">
                        {STROKES.map((d) => <path d={d} pathLength="1" stroke-dasharray="1 2" style="stroke-dashoffset:1;opacity:0" data-shade />)}
                      </g>
                      <g stroke-width="2">
                        {STROKES.map((d) => <path d={d} pathLength="1" stroke-dasharray="1 2" style="stroke-dashoffset:1;opacity:0" data-ink />)}
                      </g>
                    </g>
                    <circle cx="404" cy="110" r="0" fill="#b4461f" data-vl-dot></circle>
                    <g data-vl-lift style="opacity:0">
                      <g data-vl-nib transform="translate(-34 50) rotate(38)">
                        <g transform="scale(0.72)">
                          <ellipse cx="1" cy="1.5" rx="3.2" ry="1.2" fill="#1c1b18" opacity="0.12" />
                          <path d="M -10.5 -66 L -10.5 -118 Q -10.5 -124 -4.5 -124 L 4.5 -124 Q 10.5 -124 10.5 -118 L 10.5 -66 Z" fill="#1c1b18" />
                          <path d="M -6.5 -70 L -6.5 -118" stroke="#fffdf9" stroke-width="1.1" stroke-linecap="round" opacity="0.28" />
                          <rect x="-11.5" y="-68" width="23" height="4.5" rx="1.2" fill="#c85a32" />
                          <rect x="-11.5" y="-68" width="23" height="1.2" rx="0.6" fill="#fffdf9" opacity="0.35" />
                          <path d="M -9.5 -63.5 L -8.2 -44 L 8.2 -44 L 9.5 -63.5 Z" fill="#1c1b18" />
                          <path d="M -8.4 -50 L 8.4 -50" stroke="#fffdf9" stroke-width="0.6" opacity="0.2" />
                          <path d="M 0 0 C -2.6 -6.5 -8.6 -20 -9.2 -33 L -8.6 -45 L 8.6 -45 L 9.2 -33 C 8.6 -20 2.6 -6.5 0 0 Z" fill="#c85a32" stroke="#1c1b18" stroke-width="0.7" stroke-linejoin="round" />
                          <path d="M -6.6 -36 Q 0 -31.5 6.6 -36" fill="none" stroke="#1c1b18" stroke-width="0.6" opacity="0.55" />
                          <path d="M -5.4 -40 Q 0 -36.5 5.4 -40" fill="none" stroke="#1c1b18" stroke-width="0.5" opacity="0.35" />
                          <path d="M 0 -0.6 L 0 -24" stroke="#1c1b18" stroke-width="0.8" stroke-linecap="round" />
                          <circle cx="0" cy="-26.5" r="2.1" fill="#1c1b18" />
                          <path d="M -5.6 -30 C -5 -20 -2.6 -10 -0.9 -4" fill="none" stroke="#fffdf9" stroke-width="0.9" stroke-linecap="round" opacity="0.45" />
                          <circle cx="0" cy="-0.4" r="0.9" fill="#1c1b18" />
                        </g>
                      </g>
                    </g>
                  </svg>
                </div>

                <div class="vl-modal" aria-hidden="true">
                  <div class="vl-tabs"><span class="is-on">Iniciar sessão</span><span>Criar conta</span></div>
                  <div class="vl-form">
                    <p class="vl-eyebrow">I · ENTRAR</p>
                    <p class="vl-mt">De volta ao atelier</p>
                    <p class="vl-sub">Retome a escrita onde a deixou.</p>
                    <p class="vl-lab">Username ou email</p>
                    <p class="vl-input">leonardo_barreiras ou leonardo@vellum.pt</p>
                    <p class="vl-lab vl-lab-row"><span>Palavra-passe</span><span class="vl-forgot">Esqueceu-se?</span></p>
                    <p class="vl-input vl-input-pw"><span class="vl-eye"></span></p>
                    <p class="vl-btn">Entrar <span aria-hidden="true">→</span></p>
                  </div>
                </div>
              </div>
            ) : (
              <div class="vl-layer" data-vl-layer aria-hidden="true">
                <img src={s.src} alt={s.alt} width="800" height="500" loading="lazy" decoding="async" draggable="false" class="h-full w-full object-cover object-top" />
              </div>
            ),
          )}
        </div>
      </div>

      <div class="mt-5 flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
        <button type="button" class="vl-toggle inline-flex items-center gap-2 rounded-full border border-white/15 px-3.5 py-2 text-xs font-medium text-muted transition-colors duration-200 hover:border-white/30 hover:text-ink" data-vl-toggle>
          <Icon name="mdi:play" class="vl-i-play h-4 w-4" />
          <Icon name="mdi:pause" class="vl-i-pause h-4 w-4" />
          <span class="vl-t-play">Play tour</span>
          <span class="vl-t-pause">Pause tour</span>
        </button>
        <p class="max-w-md text-xs text-faint">Real screens captured from the live app. The entrance is redrawn from the app's own SVG paths and timings, not recorded as a video.</p>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .vl-showcase {
    --vl-accent: #e0774b;
    --vl-cream: #f2ece1;
    --vl-ease: var(--ease-smooth, cubic-bezier(0.22, 1, 0.36, 1));
    background: #15110e;
  }
  .vl-serif {
    font-family: "Newsreader", "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--vl-cream);
  }
  .vl-accent {
    color: var(--vl-accent);
  }
  .vl-glow {
    right: 0;
    top: 50%;
    width: min(60rem, 100%);
    height: 90%;
    transform: translateY(-50%);
    border-radius: 9999px;
    background: radial-gradient(closest-side, rgb(214 106 62 / 0.16), rgb(214 106 62 / 0.05) 55%, transparent 75%);
    filter: blur(28px);
  }

  /* Scene list: only the active scene shows its caption */
  .vl-scene {
    display: block;
    padding: 0.8rem 1.1rem 0.95rem;
    border-radius: 1rem;
    border: 1px solid transparent;
    opacity: 0.5;
    transition: opacity 260ms var(--vl-ease), background-color 260ms var(--vl-ease), border-color 260ms var(--vl-ease);
  }
  .vl-scene:hover {
    opacity: 0.85;
  }
  .vl-scene[aria-current="true"] {
    opacity: 1;
    background: rgb(255 255 255 / 0.035);
    border-color: rgb(255 255 255 / 0.09);
  }
  .vl-cap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 360ms var(--vl-ease);
  }
  .vl-cap-in {
    overflow: hidden;
    min-height: 0;
  }
  .vl-scene[aria-current="true"] .vl-cap {
    grid-template-rows: 1fr;
  }
  .vl-track {
    height: 2px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.1);
    overflow: hidden;
  }
  .vl-track i {
    display: block;
    height: 100%;
    background: var(--vl-accent);
    transform-origin: left center;
    transform: scaleX(var(--p, 0));
  }
  .vl-scene:not([aria-current="true"]) .vl-track i {
    transform: scaleX(0);
  }

  /* Browser window */
  .vl-window {
    overflow: hidden;
    border-radius: 0.9rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: #1d1814;
    box-shadow: 0 30px 70px -20px rgb(0 0 0 / 0.7), 0 0 0 1px rgb(0 0 0 / 0.4);
  }
  .vl-chrome {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 2.25rem;
    padding: 0 0.85rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    background: #231d18;
  }
  .vl-dots {
    display: flex;
    gap: 0.4rem;
    width: 3.6rem;
  }
  .vl-dots i {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.16);
  }
  .vl-url {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    flex: 1;
    max-width: 28rem;
    margin: 0 auto;
    padding: 0.28rem 0.75rem;
    border-radius: 0.5rem;
    background: rgb(0 0 0 / 0.28);
    color: #b9ab9a;
    font-size: 0.7rem;
    line-height: 1;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
  }
  .vl-url [data-vl-url] {
    opacity: 0.6;
  }
  .vl-chrome-gap {
    width: 3.6rem;
  }
  @media (max-width: 520px) {
    .vl-dots,
    .vl-chrome-gap {
      display: none;
    }
  }

  /* Stage: every size inside the entrance is in cqw, so it scales with the window */
  .vl-stage {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 800 / 500;
    overflow: hidden;
    background: #faf7f2;
  }
  .vl-layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.012);
    pointer-events: none;
    transition: opacity 380ms var(--vl-ease), transform 380ms var(--vl-ease);
  }
  .vl-layer.is-on {
    opacity: 1;
    transform: none;
  }

  /* Entrance */
  .vl-wall {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .vl-veil {
    position: absolute;
    inset: 0 0 auto 0;
    height: 38%;
    background: linear-gradient(to bottom, rgb(250 247 242 / 0.7), transparent);
  }
  .vl-skip {
    position: absolute;
    top: 2.3cqw;
    right: 2.6cqw;
    display: flex;
    align-items: center;
    gap: 0.9cqw;
    font-family: "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif;
    font-size: 1.45cqw;
    color: #57534c;
    opacity: var(--s, 0);
  }
  .vl-skip kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.6cqw;
    min-width: 2.9cqw;
    border-radius: 0.7cqw;
    background: rgb(228 221 208 / 0.7);
    font-family: inherit;
    font-size: 1.3cqw;
  }
  .vl-sig {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 54cqw;
    transform: translate(-50%, -50%) translateY(calc(var(--k, 0) * -23.4cqw)) scale(calc(1 - var(--k, 0) * 0.5));
    transform-origin: center;
    will-change: transform;
  }
  .vl-modal {
    position: absolute;
    left: 50%;
    bottom: 3cqw;
    width: 46cqw;
    opacity: var(--m, 0);
    transform: translateX(-50%) translateY(calc((1 - var(--m, 0)) * 2.4cqw));
    border-radius: 1.6cqw;
    border: 1px solid rgb(255 255 255 / 0.6);
    background: rgb(255 253 249 / 0.84);
    -webkit-backdrop-filter: blur(2.4cqw);
    backdrop-filter: blur(2.4cqw);
    box-shadow: 0 2.4cqw 6cqw -1cqw rgb(70 34 14 / 0.28);
    overflow: hidden;
    font-family: "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif;
    color: #1c1b18;
  }
  .vl-modal p {
    margin: 0;
  }
  .vl-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid #e4ddd0;
    font-size: 1.55cqw;
    text-align: center;
  }
  .vl-tabs span {
    padding: 1.7cqw 0 1.5cqw;
    color: #57534c;
    border-bottom: 0.25cqw solid transparent;
  }
  .vl-tabs span.is-on {
    color: #1c1b18;
    border-bottom-color: #b4461f;
  }
  .vl-form {
    padding: 2.4cqw 3cqw 2.8cqw;
  }
  .vl-eyebrow {
    font-size: 1.15cqw;
    letter-spacing: 0.14em;
    color: #57534c;
  }
  .vl-mt {
    margin-top: 0.7cqw !important;
    font-family: "Newsreader", "Iowan Old Style", Georgia, serif;
    font-size: 3.1cqw;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .vl-sub {
    margin-top: 0.7cqw !important;
    font-family: "Newsreader", "Iowan Old Style", Georgia, serif;
    font-size: 1.6cqw;
    color: #57534c;
  }
  .vl-lab {
    margin-top: 2cqw !important;
    font-size: 1.3cqw;
  }
  .vl-lab-row {
    display: flex;
    justify-content: space-between;
    margin-top: 1.5cqw !important;
  }
  .vl-forgot {
    color: #57534c;
  }
  .vl-input {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 4.3cqw;
    margin-top: 0.6cqw !important;
    padding: 0 1.4cqw;
    border: 1px solid #e4ddd0;
    border-radius: 0.9cqw;
    background: rgb(255 253 249 / 0.7);
    font-size: 1.4cqw;
    color: #9c958a;
    justify-content: flex-start;
    white-space: nowrap;
    overflow: hidden;
  }
  .vl-input-pw {
    justify-content: flex-end;
  }
  .vl-eye {
    width: 1.8cqw;
    height: 1.1cqw;
    border: 1px solid #57534c;
    border-radius: 50%;
  }
  .vl-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8cqw;
    height: 4.5cqw;
    margin-top: 1.9cqw !important;
    border-radius: 0.9cqw;
    background: #a94c2c;
    color: #fbf3ea;
    font-size: 1.55cqw;
  }

  /* Play / pause toggle shows the action it will perform */
  .vl-showcase[data-state="playing"] .vl-i-play,
  .vl-showcase[data-state="playing"] .vl-t-play,
  .vl-showcase[data-state="paused"] .vl-i-pause,
  .vl-showcase[data-state="paused"] .vl-t-pause {
    display: none;
  }
</style>

<script>
  // The timeline lives in data-steps: one entry per layer, with the scene it belongs to, how long it
  // stays, the path shown in the address bar, and whether it is the redrawn entrance.
  type Step = { scene: number; dur: number; url: string; kind: "intro" | "shot" };

  // Timings copied from the app's entrance (ms): the pen writes 150-2150, the dot lands, the reveal follows.
  const WRITE_START = 150;
  const WRITE_END = 2150;
  const PEN_LIFT = 70;
  const DOT_TAP = 110;
  const PHASE_ONE_END = 2300;
  const REVEAL = 600;
  const NIB_BASE_ANGLE = 38;
  const NIB_MAX_TILT = 25;
  const FINAL_DOT = { cx: 404, cy: 110, r: 3.4 };
  const REST = 4200; // the finished entrance, for reduced motion

  const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
  const easeInOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
  const easeOut = (t: number) => 1 - (1 - t) ** 4;

  document.querySelectorAll<HTMLElement>("[data-vl]").forEach((root) => {
    const steps: Step[] = JSON.parse(root.dataset.steps ?? "[]");
    const layers = Array.from(root.querySelectorAll<HTMLElement>("[data-vl-layer]"));
    const scenes = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-vl-scene]"));
    const urlEl = root.querySelector<HTMLElement>("[data-vl-url]");
    const win = root.querySelector<HTMLElement>("[data-vl-window]");
    const toggle = root.querySelector<HTMLButtonElement>("[data-vl-toggle]");
    if (!steps.length || steps.length !== layers.length || !toggle) return;

    // ---- Entrance (the redrawn pen) ----
    const intro = root.querySelector<HTMLElement>("[data-vl-intro]");
    const ink = intro ? Array.from(intro.querySelectorAll<SVGPathElement>("[data-ink]")) : [];
    const shade = intro ? Array.from(intro.querySelectorAll<SVGPathElement>("[data-shade]")) : [];
    const dot = intro?.querySelector<SVGCircleElement>("[data-vl-dot]") ?? null;
    const nib = intro?.querySelector<SVGGElement>("[data-vl-nib]") ?? null;
    const lift = intro?.querySelector<SVGGElement>("[data-vl-lift]") ?? null;
    type Seg = { i: number; length: number; start: number; end: number };
    let segs: Seg[] = [];
    let lengths: number[] = [];
    let dotStart = 0;
    let tilt = 0;

    const prepare = () => {
      if (segs.length || !ink.length) return;
      lengths = ink.map((p) => p.getTotalLength());
      const total = lengths.reduce((a, b) => a + b, 0);
      const budget = WRITE_END - WRITE_START - PEN_LIFT * ink.length - DOT_TAP;
      let cursor = WRITE_START;
      lengths.forEach((length, i) => {
        if (i > 0) cursor += PEN_LIFT;
        const d = (length / total) * budget;
        segs.push({ i, length, start: cursor, end: cursor + d });
        cursor += d;
      });
      dotStart = cursor + PEN_LIFT;
    };

    const pointOf = (i: number, at: number) => ink[i].getPointAtLength(clamp(at, 0, lengths[i]));
    const placeNib = (x: number, y: number, target: number, up = 0) => {
      tilt += (target - tilt) * 0.16;
      nib?.setAttribute("transform", `translate(${x.toFixed(2)} ${(y - up).toFixed(2)}) rotate(${(NIB_BASE_ANGLE + tilt).toFixed(2)})`);
    };

    const renderIntro = (t: number) => {
      if (!intro || !nib || !lift) return;
      prepare();
      if (t <= 0) tilt = 0;

      // Strokes
      segs.forEach((seg) => {
        const p = clamp((t - seg.start) / (seg.end - seg.start), 0, 1);
        for (const el of [ink[seg.i], shade[seg.i]]) {
          el.style.strokeDashoffset = String(1 - p);
          el.style.opacity = p > 0 ? "1" : "0";
        }
      });
      dot?.setAttribute("r", String(FINAL_DOT.r * easeInOut(clamp((t - dotStart) / DOT_TAP, 0, 1))));

      // The nib follows the exact tip of the stroke, tilting along the curve
      const active = segs.find((s) => t >= s.start && t < s.end);
      if (active) {
        const at = ((t - active.start) / (active.end - active.start)) * active.length;
        const tip = pointOf(active.i, at);
        const ahead = pointOf(active.i, at + 1.5);
        const behind = pointOf(active.i, at - 1.5);
        const theta = Math.atan2(ahead.y - behind.y, ahead.x - behind.x);
        placeNib(tip.x, tip.y, clamp(16 * Math.sin(theta) - 5 * Math.cos(theta), -NIB_MAX_TILT, NIB_MAX_TILT));
      } else if (t < WRITE_START) {
        const first = pointOf(0, 0);
        placeNib(first.x, first.y, 0, (1 - Math.max(t, 0) / WRITE_START) * 6);
      } else if (t < dotStart + DOT_TAP) {
        const prev = [...segs].reverse().find((s) => t >= s.end);
        const next = segs.find((s) => t < s.start);
        const from = prev ? pointOf(prev.i, prev.length) : pointOf(0, 0);
        const to = next ? pointOf(next.i, 0) : { x: FINAL_DOT.cx, y: FINAL_DOT.cy };
        const departAt = prev ? prev.end : WRITE_START;
        const arriveAt = next ? next.start : dotStart;
        if (t < arriveAt) {
          const k = easeInOut(clamp((t - departAt) / (arriveAt - departAt), 0, 1));
          placeNib(from.x + (to.x - from.x) * k, from.y + (to.y - from.y) * k, 0, Math.sin(k * Math.PI) * 5);
        } else {
          const k = clamp((t - dotStart) / DOT_TAP, 0, 1);
          placeNib(FINAL_DOT.cx, FINAL_DOT.cy, 0, Math.sin(k * Math.PI) * -1.2);
        }
      } else {
        placeNib(FINAL_DOT.cx, FINAL_DOT.cy, 0);
      }

      // The pen appears at the start, lifts away after the dot
      const appear = clamp(t / 120, 0, 1);
      const away = easeOut(clamp((t - PHASE_ONE_END) / 320, 0, 1));
      lift.style.opacity = String(appear * (1 - away));
      lift.setAttribute("transform", `translate(${(12 * away).toFixed(2)} ${(-12 * away).toFixed(2)})`);

      // Reveal: the signature shrinks to the top while the modal rises
      intro.style.setProperty("--k", String(easeOut(clamp((t - PHASE_ONE_END) / REVEAL, 0, 1))));
      intro.style.setProperty("--m", String(easeOut(clamp((t - PHASE_ONE_END - 120) / REVEAL, 0, 1))));
      intro.style.setProperty("--s", t <= 0 ? "0" : String(1 - clamp((t - PHASE_ONE_END) / 300, 0, 1)));
    };

    // ---- Tour ----
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const sceneFirst = scenes.map((_, s) => steps.findIndex((st) => st.scene === s));
    const sceneTotal = scenes.map((_, s) => steps.filter((st) => st.scene === s).reduce((a, st) => a + st.dur, 0));

    let i = 0;
    let t = 0;
    let last = 0;
    let raf = 0;
    let wantPlay = !reduce;
    let onScreen = false;
    let hovered = false;
    let restState = reduce; // reduced motion: the entrance sits finished until the visitor presses play

    const running = () => wantPlay && onScreen && !hovered && !document.hidden;
    const setState = () => {
      root.dataset.state = wantPlay ? "playing" : "paused";
    };

    const progress = () => {
      const s = steps[i].scene;
      const before = steps.slice(0, i).filter((st) => st.scene === s).reduce((a, st) => a + st.dur, 0);
      scenes[s].style.setProperty("--p", String(Math.min(1, (before + t) / sceneTotal[s])));
    };

    const show = (n: number) => {
      i = (n + steps.length) % steps.length;
      t = 0;
      layers.forEach((l, k) => {
        l.classList.toggle("is-on", k === i);
        l.setAttribute("aria-hidden", k === i ? "false" : "true");
      });
      scenes.forEach((b, s) => {
        const on = s === steps[i].scene;
        b.setAttribute("aria-current", on ? "true" : "false");
        if (!on) b.style.removeProperty("--p");
      });
      if (urlEl) urlEl.textContent = steps[i].url;
      if (steps[i].kind === "intro") renderIntro(restState ? REST : 0);
      progress();
    };

    const frame = (now: number) => {
      if (!running()) {
        raf = 0;
        return;
      }
      t += Math.min(now - last, 100); // clamp so a background tab doesn't skip scenes
      last = now;
      if (steps[i].kind === "intro") renderIntro(t);
      if (t >= steps[i].dur) show(i + 1);
      else progress();
      raf = requestAnimationFrame(frame);
    };

    const sync = () => {
      if (running() && !raf) {
        last = performance.now();
        raf = requestAnimationFrame(frame);
      }
    };

    // Preload every screen the first time the tour gets close to the viewport
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          onScreen = e.isIntersecting && e.intersectionRatio > 0.35;
          if (e.isIntersecting) root.querySelectorAll<HTMLImageElement>("img[loading=lazy]").forEach((img) => (img.loading = "eager"));
        });
        sync();
      },
      { threshold: [0, 0.35, 0.6], rootMargin: "200px 0px" },
    );
    io.observe(root);

    toggle.addEventListener("click", () => {
      wantPlay = !wantPlay;
      if (wantPlay && restState) {
        restState = false;
        show(i); // replay the entrance from the first stroke
      }
      setState();
      sync();
    });
    scenes.forEach((b, s) => {
      b.addEventListener("click", () => {
        if (steps[sceneFirst[s]].kind === "intro" && reduce && !wantPlay) restState = true;
        show(sceneFirst[s]);
        sync();
      });
    });
    win?.addEventListener("pointerenter", () => {
      hovered = true;
    });
    win?.addEventListener("pointerleave", () => {
      hovered = false;
      sync();
    });
    document.addEventListener("visibilitychange", sync);

    setState();
    show(0);
  });
</script>
